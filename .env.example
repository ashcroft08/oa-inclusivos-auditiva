# Secretos del backend de OA Inclusivos.
# Copiar a .env y completar con los valores reales (nunca commitear .env).

# Password del usuario de la base de datos de Moodle
DB_PASSWORD=cambiar-por-password-real

# Credenciales LTI 1.1 (deben coincidir con la herramienta externa en Moodle)
LTI_CONSUMER_KEY=moodle-oa-dev
LTI_SHARED_SECRET=generar-un-valor-aleatorio-largo

# Secreto de sesion de Express
SESSION_SECRET=generar-otro-valor-aleatorio-largo
